classDiagram
    class ลูกค้า {
        +String ชื่อ
        +String เบอร์โทร
        +สั่งอาหาร()
    }
    class ออเดอร์ {
        +int รหัสออเดอร์
        +DateTime วันที่สร้าง
        +double ยอดรวม
        +String สถานะ
        +คำนวณยอดรวม()
        +ยืนยันออเดอร์()
    }
    class รายการอาหาร {
        +int จำนวน
        +double ราคา
        +คำนวณยอดแต่ละรายการ()
    }
    class เมนู {
        +String ชื่อเมนู
        +double ราคาปกติ
        +String หมวดหมู่
    }
    class การชำระเงิน {
        +String วิธีชำระเงิน
        +double จำนวนเงิน
        +String สถานะการชำระ
        +ประมวลผลชำระเงิน()
    }

    ลูกค้า "1" -- "*" ออเดอร์ : สั่ง >
    ออเดอร์ "1" *-- "*" รายการอาหาร : ประกอบด้วย >
    รายการอาหาร "*" -- "1" เมนู : อธิบายถึง >
    ออเดอร์ "1" -- "1" การชำระเงิน : มี >
